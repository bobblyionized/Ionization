#include <winver.h>

1 ICON "@CMAKE_SOURCE_DIR@/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
 PRODUCTVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "bobblyionized"
      VALUE "FileDescription", "Ionization"
      VALUE "FileVersion", "@IONIZATION_VERSION@"
      VALUE "ProductName", "Ionization"
      VALUE "ProductVersion", "@IONIZATION_VERSION@"
      VALUE "OriginalFilename", "Ionization.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
